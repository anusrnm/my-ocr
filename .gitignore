*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit testing / coverage reports
htmlcov/
.toml
.cache
.pytest_cache/
.testmondata
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.border
.htmlcov/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the setup is personal.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you do not want it, uncomment the next line:
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   However, if you do not want it, uncomment the next line:
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
.pdm-python
pdm.toml
pdm.lock

# venv / Virtual Environments
#   It is heavily recommended not to include virtual environments in version control.
.venv/
venv/
ENV/
env/
target/

# Environment variables and secrets
.env
.env.local
.env.*
.secrets

# IDEs and Editors
.vscode/
.idea/
*.swp

# Local OCR review artifacts
.enhanced/
*.swo
.DS_Store
Thumbs.db

*.patch
